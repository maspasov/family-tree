# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files — never commit real Firebase keys via these.
# (The Firebase *web* config is not secret, but keeping it out of git keeps
#  the repo reusable. Real protection comes from Firestore security rules.)
.env
.env.local
.env.*.local

# Service-account keys for the scripts/ admin tools — these ARE secret.
*serviceaccount*.json
*service-account*.json
*-key.json
firebase-adminsdk-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# e2e (Playwright)
/test-results
/playwright-report
/blob-report
/playwright/.cache
e2e/.auth
e2e/.env.e2e
