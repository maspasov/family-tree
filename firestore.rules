rules_version = '2';

// Security model for „Родословно дърво“ (invite-only):
//   * the site is NOT public — only Google accounts whose (verified) e-mail is
//     listed in config/app.editors may READ *or* write the tree at all;
//   * config/app itself stays publicly readable so the client (and these
//     rules) can look up who's on the list, but no one can write to it from
//     the app — edit the array from the Firebase console only.
//
// Bootstrap: before anyone can use the app you must create the document
//   config/app  ->  { editors: ["you@gmail.com", "someone.else@gmail.com"] }
// in the Firebase console (Firestore Database -> Start collection "config",
// document id "app", field "editors" = array of strings).

service cloud.firestore {
  match /databases/{database}/documents {

    function editors() {
      return get(/databases/$(database)/documents/config/app).data.editors;
    }

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/app)
        && request.auth.token.email.lower() in editors();
    }

    // Public, read-only. Change the editors list from the console, not the app.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    match /persons/{personId} {
      allow read: if isEditor();

      allow create: if isEditor()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && (request.resource.data.parentId == null
            || request.resource.data.parentId is string);

      allow update: if isEditor()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120;

      allow delete: if isEditor();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
