rules_version = '2';

// Security model for „Родословно дърво“ — multi-tree.
//
//   config/app                     -> { admins: ["you@gmail.com", ...] }
//     Public read. `admins` may create/delete trees and edit any tree.
//     Manage the array with scripts/set-admins.mjs or the Firebase console.
//
//   trees/{treeId}                 -> { slug, name, editors: [...], viewers: [...] }
//     Public read (a display name + two e-mail lists — same sensitivity as
//     config/app). `treeId` IS the slug. A tree's `editors` may write to it;
//     `viewers` may read it. Everything the tree owns is nested underneath.

service cloud.firestore {
  match /databases/{database}/documents {

    function configData() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data
        : {};
    }
    function admins() {
      return configData().get('admins', []);
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function callerEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return verified() && callerEmail() in admins();
    }

    function treeExists(treeId) {
      return exists(/databases/$(database)/documents/trees/$(treeId));
    }
    function treeData(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data;
    }
    function isTreeEditor(treeId) {
      return isAdmin()
        || (verified() && treeExists(treeId)
            && callerEmail() in treeData(treeId).get('editors', []));
    }
    function isTreeViewer(treeId) {
      return isTreeEditor(treeId)
        || (verified() && treeExists(treeId)
            && callerEmail() in treeData(treeId).get('viewers', []));
    }

    // ---- global config ----
    match /config/app {
      allow read: if true;
      // Only the admins list is client-writable, and it can't be emptied
      // (that would lock everyone out of tree creation). Creating/deleting the
      // doc itself stays console-only.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins'])
        && request.resource.data.admins is list
        && request.resource.data.admins.size() > 0;
    }

    // ---- one document per family tree ----
    match /trees/{treeId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.slug is string
        && request.resource.data.slug == treeId
        && request.resource.data.editors is list
        && request.resource.data.editors.size() > 0
        && request.resource.data.viewers is list;

      // Admins may change anything; a tree's own editors may only touch its
      // role lists and chrome, and can never empty the editor list.
      allow update: if isAdmin()
        || (isTreeEditor(treeId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['editors', 'viewers', 'name', 'subtitle', 'motto'])
            && request.resource.data.editors is list
            && request.resource.data.editors.size() > 0);

      allow delete: if isAdmin();

      match /persons/{personId} {
        allow read: if isTreeViewer(treeId);
        allow create, update: if isTreeEditor(treeId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 120;
        allow delete: if isTreeEditor(treeId);

        match /photos/{photoId} {
          allow read: if isTreeViewer(treeId);
          allow create: if isTreeEditor(treeId)
            && request.resource.data.dataUrl is string
            && request.resource.data.dataUrl.size() > 0
            && request.resource.data.dataUrl.size() < 900000;
          allow delete: if isTreeEditor(treeId);
        }
      }

      match /archive/{photoId} {
        allow read: if isTreeViewer(treeId);
        allow create: if isTreeEditor(treeId)
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() > 0
          && request.resource.data.dataUrl.size() < 900000;
        allow update, delete: if isTreeEditor(treeId);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
